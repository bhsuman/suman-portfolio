# ============================================================================
# SUMAN PORTFOLIO — SERVER ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================================================
# Copy this file to `.env` for local server use. NEVER commit `.env` to Git.
# All values below are safe placeholders only.

# Server Port (Default: 8000)
PORT=8000

# Allowed CORS Origin for API endpoints
ALLOWED_ORIGIN=http://localhost:8000

# Optional: Server-Side Gemini API Key for Suman AI (Never expose to frontend)
# Leave empty to use the built-in deterministic portfolio intelligence engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: Salted SHA-256 hash of your Owner PIN (Salt: "suman_portfolio_v1:")
# Generate via: python -c "import hashlib; print(hashlib.sha256(b'suman_portfolio_v1:YOUR_PIN').hexdigest())"
PORTFOLIO_OWNER_PIN_HASH=

# Optional: Private server-side ntfy.sh topic for mobile push alerts
PORTFOLIO_NTFY_TOPIC=

